{
  "expo": {
    "name": "Titulación ULEAM",
    "slug": "titulacion-uleam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ec.edu.uleam.titulacion"
    },
    "android": {
      "package": "ec.edu.uleam.titulacion",
      "adaptiveIcon": {
        "backgroundColor": "#06314F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06314F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para escanear la imagen de tu firma.",
          "cameraPermission": "La app usa la cámara para fotografiar tu firma en una hoja blanca.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-transparent-navigation-bar"
    ],
    "scheme": "uleamtitulacion",
    "experiments": {
      "typedRoutes": false
    }
  }
}
