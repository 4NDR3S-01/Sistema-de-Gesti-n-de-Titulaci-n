AUTH_SECRET=
AUTH_URL=http://localhost:3000
# To open the dev server from other devices on your network, comment out AUTH_URL
# and list this computer's IPs: DEV_ALLOWED_ORIGINS=192.168.1.20
DEV_ALLOWED_ORIGINS=

# PostgreSQL (ver database/README.md)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_titulacion
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# Con DB_SSL=true se verifica el certificado. Solo si el servidor usa uno autofirmado:
# DB_SSL_ALLOW_SELF_SIGNED=true

# Pon TRUST_PROXY=true solo si la app corre detrás de un proxy inverso (nginx, etc.)
# que fija X-Real-IP / X-Forwarded-For; así el límite de intentos por IP es confiable.
TRUST_PROXY=false

# Login with email + password validated against the users table (bcrypt).
PASSWORD_AUTH_ENABLED=false
NEXT_PUBLIC_PASSWORD_AUTH_ENABLED=false

# Dominios institucionales (opcional; estos son los valores por defecto).
# Estudiantes usan live.uleam.edu.ec; el personal, uleam.edu.ec.
# NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=live.uleam.edu.ec
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=live.uleam.edu.ec,uleam.edu.ec

# Microsoft 365 de la ULEAM. El botón "Entrar con mi cuenta Microsoft ULEAM"
# aparece cuando ID y SECRET están configurados (ver AUTH_SETUP.md).
# El issuer por defecto ya es el tenant de la ULEAM; solo cámbialo si TI lo indica.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/31a17900-7589-4cfc-b11a-f4e83c27b8ed/v2.0
