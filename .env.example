AUTH_SECRET=
AUTH_URL=http://localhost:3000

# PostgreSQL (ver database/README.md)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_titulacion
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Login with email + password validated against the users table (bcrypt).
PASSWORD_AUTH_ENABLED=false
NEXT_PUBLIC_PASSWORD_AUTH_ENABLED=false

# Microsoft Entra ID: configure these with the university's registered app.
NEXT_PUBLIC_MICROSOFT_ENABLED=false
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Microsoft accounts only get access if their email exists and is active in the users table.
